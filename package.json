{
  "name": "@cubiczan/chp-mcp",
  "version": "0.2.0",
  "description": "Spend + tool-approval gate for AI agents — budget caps, HITL, and signed receipts so an MCP allowlist is never treated as authorization.",
  "mcpName": "io.github.icohangar-ops/chp-mcp",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "chp-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "examples",
    "README.md",
    "LICENSE",
    "!dist/*.test.js",
    "!dist/*.test.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"const fs=require('fs');const p='dist/index.js';let t=fs.readFileSync(p,'utf8');if(!t.startsWith('#!'))fs.writeFileSync(p,'#!/usr/bin/env node\\n'+t);fs.chmodSync(p,0o755)\"",
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.ts",
    "test": "npm run build && node --test dist/*.test.js",
    "prepublishOnly": "npm run build",
    "mcpb:pack": "bash scripts/mcpb-pack.sh",
    "mcpb:validate": "mcpb validate manifest.json",
    "smithery:publish": "bash scripts/smithery-publish-mcpb.sh",
    "smithery:agent-token": "bash scripts/smithery-agent-token.sh"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "spend-approval",
    "spend-limits",
    "budget-guard",
    "approval-gate",
    "approval-receipt",
    "tool-authorization",
    "allowlist",
    "human-in-the-loop",
    "hitl",
    "agent-governance",
    "audit-trail",
    "chp",
    "consensus-hardening",
    "claude",
    "cursor"
  ],
  "author": "Shyam Desigan <sam@cubiczan.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icohangar-ops/cubiczan-chp-mcp.git"
  },
  "homepage": "https://github.com/icohangar-ops/cubiczan-chp-mcp#readme",
  "bugs": {
    "url": "https://github.com/icohangar-ops/cubiczan-chp-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cubiczan/chp": "^0.1.1",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
